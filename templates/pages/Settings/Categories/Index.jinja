{#def
    user: DetailedUser,
    entries: list[UserCategoryEntry],
    category_catalog: dict[str, CatalogEntry],
#}

<SettingsLayout title="Settings - Categories" user={{ user }} page="categories">
    <div class="flex flex-col gap-6">
        <div>
            <h2 class="text-lg font-semibold">Homepage Categories</h2>
            <p class="text-sm opacity-70 mt-1">
                Choose which categories appear on your homepage and drag to reorder them.
            </p>
        </div>

        <Settings.Categories.List entries={{ entries }} category_catalog={{ category_catalog }} />

        <div class="divider">Add Custom Category</div>

        <Settings.Categories.AddCustomForm />
    </div>
</SettingsLayout>

<script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.2/Sortable.min.js"></script>
<script>
    function initSortable() {
        var el = document.getElementById('category-list');
        if (!el) return;
        if (el._sortable) el._sortable.destroy();
        el._sortable = Sortable.create(el, {
            handle: '.drag-handle',
            animation: 150,
            onEnd: function () {
                var listEl = document.getElementById('category-list');
                var ids = Array.from(listEl.querySelectorAll('[data-id]')).map(function (item) {
                    return item.dataset.id;
                });
                htmx.ajax('POST', listEl.dataset.reorderUrl, {
                    target: '#category-list-container',
                    swap: 'outerHTML',
                    values: { order: ids.join(',') }
                });
            }
        });
    }

    document.addEventListener('DOMContentLoaded', initSortable);
    document.addEventListener('htmx:afterSettle', initSortable);
</script>
