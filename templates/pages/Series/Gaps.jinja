{#def
    gaps: list[SeriesGap],
    still_discovering: bool,
    region: audible_region_type,
    user: DetailedUser,
    auto_start_download: bool,
#}

<BaseLayout title="Series Gaps" user={{ user }}>
<div class="max-w-4xl mx-auto p-4 flex flex-col gap-4">
    <h1 class="text-2xl font-bold">Series Gaps</h1>
    <p class="text-sm opacity-60">
        Series you own at least one book from, but not all of.
    </p>

    {% if still_discovering %}
        <div role="alert" class="alert alert-info">
            <icons.InfoCircle />
            <span>Still scanning your library for series info — refresh in a bit to discover more.</span>
        </div>
    {% endif %}

    {% if not gaps %}
        <div role="alert" class="alert">
            <icons.InfoCircle />
            <span>No gaps found. Either you're fully caught up, or none of your library's books are linked to a series yet.</span>
        </div>
    {% else %}
        <div class="flex flex-col gap-4">
            {% for gap in gaps %}
                <SeriesGapCard gap={{ gap }} region={{ region }} user={{ user }} auto_start_download={{ auto_start_download }} />
            {% endfor %}
        </div>
    {% endif %}
</div>
</BaseLayout>
