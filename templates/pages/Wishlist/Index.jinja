{#def
    results: list[AudiobookWishlistResult],
    user: DetailedUser,
    counts: WishlistCounts,
    abs_configured: bool = False,
    sort = "title",
    sort_dir = "asc",
    hide_not_found = False,
#}

<WishlistLayout title="Wishlist" user={{ user }} counts={{ counts }} page="wishlist">
<div class="flex justify-end items-center gap-4">
    <label class="label cursor-pointer gap-2" title="Hide books flagged as not found">
        <span class="label-text text-sm">Hide not found</span>
        <input type="checkbox"
               class="toggle toggle-error toggle-sm"
               {% if hide_not_found %}checked{% endif %}
               onchange="location.href='{{ base_url }}/wishlist?sort={{ sort }}&amp;sort_dir={{ sort_dir }}&amp;hide_not_found=' + this.checked" />
    </label>
    {% if abs_configured and user.is_admin() %}
        <button class="btn btn-sm"
                hx-post="{{ base_url }}/wishlist/hx-abs-sync?sort={{ sort }}&amp;sort_dir={{ sort_dir }}&amp;hide_not_found={{ hide_not_found|lower }}"
                hx-target="#book-table-body"
                hx-swap="outerHTML"
                hx-disabled-elt="this">
            <icons.Download />
            Sync with AudioBookShelf
        </button>
    {% endif %}
</div>
<div class="overflow-x-auto flex-1 min-h-0 border-b pb-2 border-b-base-200">
    <Wishlist.Wishlist results={{ results }} user={{ user }} page="wishlist" counts={{ counts }} sort={{ sort }} sort_dir={{ sort_dir }} hide_not_found={{ hide_not_found }} />
</div>
</WishlistLayout>
