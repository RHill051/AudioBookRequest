{#def
    label: str,
    column: str,
    current_sort: str,
    current_dir: str,
    sort_path: str,
#}
{% set next_dir = "desc" if current_sort == column and current_dir == "asc" else "asc" %}
<th>
    <a href="{{ base_url }}{{ sort_path }}?sort={{ column }}&amp;sort_dir={{ next_dir }}"
       class="flex items-center gap-1 cursor-pointer hover:text-primary whitespace-nowrap">
        {{ label }}
        {% if current_sort == column %}
            <span class="text-xs">{{ "↑" if current_dir == "asc" else "↓" }}</span>
        {% endif %}
    </a>
</th>
